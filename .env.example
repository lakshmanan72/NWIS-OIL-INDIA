# ============================================================
# NWIS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and adjust variables as required.
# DO NOT COMMIT SENSITIVE PASSWORDS OR JWT SECRETS TO VERSION CONTROL.
# ============================================================

# Environment mode: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Persistence Data Backend: 'csv' (default development) or 'postgres' (production)
DATA_BACKEND=csv

# PostgreSQL + PostGIS Connection URL
# Example: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=
POSTGIS_ENABLED=true

# Real-Time Telemetry Storage: 'postgres' or 'memory'
TELEMETRY_STORAGE=postgres

# Real-Time Alert Storage: 'postgres' or 'json'
ALERT_STORAGE=postgres

# Vector Store Backend: 'local' (sentence-transformers / tfidf) or 'postgres' (pgvector)
VECTOR_BACKEND=local

# Security & Authentication
# In production, JWT_SECRET must be an unpredictable cryptographic secret (min 32 chars)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Logging & Observability: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# ============================================================
# Phase 8 — eRTMAC & WITSML Real-Time Telemetry Integrations
# ============================================================

# eRTMAC Integration (OIL eRTMAC Upstream Scada/Rig Feed)
ERTMAC_ENABLED=false
ERTMAC_BASE_URL=
ERTMAC_USERNAME=
ERTMAC_PASSWORD=
ERTMAC_API_KEY=
ERTMAC_WELL_ID=

# WITSML Integration (1.3.1.1 / 1.4.1.1 SOAP / Store Interface)
WITSML_ENABLED=false
WITSML_URL=
WITSML_USERNAME=
WITSML_PASSWORD=
WITSML_WELL_ID=
WITSML_WELLBORE_ID=

# Streaming Queue & Retention Limits
TELEMETRY_QUEUE_MAX_SIZE=5000
STORE_RAW_TELEMETRY=false
INTEGRATION_TIMEOUT_SECONDS=10
INTEGRATION_RETRY_MAX=5
